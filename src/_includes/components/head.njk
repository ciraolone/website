<head>
  <meta charset="UTF-8">
  {# viewport-fit=cover: su Chrome Android con la navigazione a gesti la pagina scorre anche sotto
     la barra di sistema in fondo allo schermo. Senza "cover" la barra di acquisto fissa in basso
     resta appoggiata sopra quella zona e, scorrendo, sotto di lei passa il contenuto come in uno
     spazio vuoto. Con "cover" la barra arriva fino al bordo e si allarga da sola dell'ingombro
     di sistema (env(safe-area-inset-bottom) in sidebar.njk); i lati li protegge il body in base.njk #}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="author" content="{{ site.author }}">

  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>

  {# SEO e anteprime social. L'indirizzo canonico dice a Google qual è l'URL "vero" della pagina
     (con lo slash finale, come le genera Eleventy). L'immagine dell'anteprima è quella dell'hero
     della pagina, se c'è, altrimenti la foto di Andrea #}
  {%- set urlPagina = site.url + page.url -%}
  {%- set titoloPagina = title or site.title -%}
  {%- set descrizionePagina = description or site.description %}
  <link rel="canonical" href="{{ urlPagina }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ titoloPagina }}">
  <meta property="og:description" content="{{ descrizionePagina }}">
  <meta property="og:url" content="{{ urlPagina }}">
  <meta property="og:image" content="{{ (hero.image or "/assets/images/andrea.png") | ogImage }}">
  <meta name="twitter:card" content="summary_large_image">

  {# Dati strutturati: solo in homepage, dove il sito presenta Andrea come persona #}
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.url }}/",
    "image": "{{ "/assets/images/andrea.png" | ogImage }}",
    "description": "{{ site.description }}",
    "sameAs": [
      "https://www.youtube.com/@ciraolone",
      "https://www.instagram.com/ciraolone"
    ]
  }
  </script>
  {% endif %}

  <!-- Preload Accent Font: carica il font titoli prima del CSS per ridurre il flash -->
  {% if fonts.accent.preload %}
  <link rel="preload" href="{{ fonts.accent.file }}" as="font" type="font/{{ fonts.accent.format }}" crossorigin>
  {% endif %}

  <!-- CSS -->
  <link rel="stylesheet" href="/assets/css/main.css?v={{ build.versione }}">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
</head>
